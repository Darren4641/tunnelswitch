HOME = Path(os.environ.get("TUNSW_HOME", Path.home() / ".config" / "tunnelswitch"))
LEGACY_HOME = Path.home() / ".config" / "dbtunnel"
CONFIG = HOME / "config.json"
PIDFILE = HOME / "daemon.pid"
STATUS = HOME / "status.json"
DESIRED = HOME / "desired.json"
LOGFILE = HOME / "daemon.log"
KNOWN_HOSTS = HOME / "known_hosts"
EIC_KEY = HOME / "eic_ed25519"
ASKPASS = HOME / "askpass.sh"
UPDATE_STATUS = HOME / "update.json"
UPDATE_LOG = HOME / "update.log"
APP_BUNDLE = Path("/Applications/TunnelSwitch.app")

LOG_MAX_BYTES = 5 * 1024 * 1024
STABLE_SECONDS = 60
MAX_BACKOFF = 60

DEFAULT_CONFIG = {"groups": {}}
GROUP_NAME_MAX = 30

TYPES = ("eic", "ssh", "eic-direct", "web", "shell")
SSH_TYPES = ("ssh", "web", "shell")  # host·user·인증으로 SSH 접속하는 방식
AUTHS = ("key", "password")
SCHEMES = ("http", "https")
WEB_DEFAULT_HOST = "127.0.0.1"


# ---------------------------------------------------------------- config

def ensure_home():
    """설정 디렉터리는 본인만 읽을 수 있게 한다 (로그에 내부 IP·엔드포인트, EIC 개인키가 있다)."""
    HOME.mkdir(parents=True, exist_ok=True)
    os.chmod(HOME, 0o700)


def load_config():
    ensure_home()
    if not CONFIG.exists():
        save_config(DEFAULT_CONFIG)
    with CONFIG.open(encoding="utf-8") as f:
        return json.load(f)


def save_config(cfg):
    write_json(CONFIG, cfg)
    os.chmod(CONFIG, 0o600)


def write_json(path, data):
    ensure_home()
    tmp = path.with_suffix(".tmp")
    with tmp.open("w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)


def find_group_key(cfg, name):
    """키 또는 표시 이름으로 그룹 키를 찾는다. 없으면 None"""
    if name in cfg["groups"]:
        return name
    for key, group in cfg["groups"].items():
        if group.get("label") == name:
            return key
    return None


def resolve_group(cfg, name):
    key = find_group_key(cfg, name)
    if key is None:
        if not cfg["groups"]:
            die("그룹이 없습니다. 먼저 만드세요: tunsw group-add <이름>")
        names = ", ".join(label(cfg, k) for k in cfg["groups"])
        die(f"그룹 '{name}' 이 없습니다. 있는 그룹: {names}")
    return key


def get_group(cfg, name):
    return cfg["groups"][resolve_group(cfg, name)]


def validate_group_name(cfg, name, exclude=None):
    """새 그룹 이름 검증. exclude: 이름을 바꾸는 중인 그룹의 키"""
    if not name:
        return "그룹 이름을 입력하세요."
    if len(name) > GROUP_NAME_MAX:
        return f"그룹 이름은 {GROUP_NAME_MAX}자 이하여야 합니다."
    if name.startswith("-") or "/" in name:
        return "그룹 이름은 '-' 로 시작하거나 '/' 를 포함할 수 없습니다."
    other = find_group_key(cfg, name)
    if other is not None and other != exclude:
        return f"'{name}' 그룹이 이미 있습니다."
    return None


def label(cfg, name):
    return cfg["groups"][name].get("label") or name


def remote_host_of(t):
    """web 은 대상 호스트를 비우면 SSH 서버 자신(127.0.0.1)으로 본다."""
    if t["type"] == "web":
        return t.get("remote_host") or WEB_DEFAULT_HOST
    return t.get("remote_host")


def is_tunnel(t):
    """shell(SSH 접속)은 포워딩이 없어 켜고 끄지 않는다. 데몬·상태 계산에서 뺀다."""
    return t["type"] != "shell"


def target_of(t):
    if t["type"] == "shell":
        port = t.get("ssh_port", 22)
        return f"{t['user']}@{t['host']}" + (f":{port}" if port != 22 else "")
    if t["type"] == "eic-direct":
        return f"{t['private_ip']}:{t['remote_port']}"
    return f"{remote_host_of(t)}:{t['remote_port']}"


def via_of(t):
    if t["type"] == "eic":
        return f"eic {t['instance_id']} ({t['profile']})"
    if t["type"] in SSH_TYPES:
        auth = "비밀번호" if t.get("auth") == "password" else "pem"
        return f"ssh {t['user']}@{t['host']} ({auth})"
    return f"eic-direct {t['eice_id']} ({t['profile']})"


def url_of(t):
    """web 터널을 브라우저로 열 주소. 다른 방식은 None"""
    if t["type"] != "web":
        return None
    return f"{t.get('scheme', 'http')}://localhost:{t['local_port']}"


# ---------------------------------------------------------------- 대화형 입력

def ask(prompt, default=None, required=True, validator=None):
    suffix = f" [{default}]" if default not in (None, "") else ""
    while True:
        try:
            value = input(f"  {prompt}{suffix}: ").strip()
        except EOFError:
            die("\n입력이 중단되었습니다.")
        if not value and default is not None:
            value = str(default)
        if not value:
            if not required:
                return None
            print("    값을 입력하세요.")
            continue
        if validator:
            error = validator(value)
            if error:
                print(f"    {error}")
                continue
        return value


def port_validator(value):
    if not value.isdigit() or not 1 <= int(value) <= 65535:
        return "1~65535 사이 숫자여야 합니다."
    return None


def file_validator(value):
    if not Path(value).expanduser().is_file():
        return f"파일이 없습니다: {value}"
    return None


def choose(prompt, options):
    """options: [(value, 표시문구)] → 선택된 value"""
    for i, (_, text) in enumerate(options, 1):
        print(f"    {i}) {text}")
    while True:
        raw = ask(prompt)
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1][0]
        for value, _ in options:
            if raw == value:
                return value
        print("    목록의 번호를 입력하세요.")


def choose_group(cfg, prompt="그룹"):
    if not cfg["groups"]:
        die("그룹이 없습니다. 먼저 만드세요: tunsw group-add <이름>")
    options = [(k, f"{v.get('label') or k} ({k}) — 터널 {len(v['tunnels'])}개")
               for k, v in cfg["groups"].items()]
    return choose(prompt, options)


# ---------------------------------------------------------------- 명령: 등록/조회

def cmd_add(args):
    if args.json:
        if not args.group:
            die("--json 에는 그룹을 지정해야 합니다.")
        add_json(args)
        return
    cfg = load_config()
    group_name = args.group or choose_group(cfg)
    group = get_group(cfg, group_name)
    print(f"[{label(cfg, group_name)}] 터널 등록 (Enter = [기본값])")
    tunnels = group["tunnels"]
    names = {t["name"] for t in tunnels}
    ports = {t["local_port"]: t["name"] for t in tunnels}

    def name_validator(v):
        return f"'{v}' 는 이미 있습니다." if v in names else None

    def local_port_validator(v):
        error = port_validator(v)
        if error:
            return error
        if int(v) in ports:
            return f"로컬 포트 {v} 는 '{ports[int(v)]}' 가 쓰고 있습니다."
        return None

    t = {"name": ask("이름 (예: dev-rds)", validator=name_validator)}
    t["type"] = choose("방식", [
        ("eic", "eic        — EIC 로 배스천 EC2 경유 (RDS 접속용)"),
        ("ssh", "ssh        — pem 키로 공인 배스천 경유"),
        ("eic-direct", "eic-direct — EIC 로 내부 IP 에 직접 (배스천 없이)"),
        ("web", "web        — SSH 경유 웹 서비스 (ArgoCD·Jenkins 등, 브라우저로 열기)"),
        ("shell", "shell      — 터널 없이 SSH 접속 (ssh user@host, 터미널로 열기)"),
    ])

    def ask_ssh_login(kind):
        t["host"] = ask(f"{kind} 호스트/IP")
        t["user"] = ask(f"{kind} 유저", default="ec2-user")
        t["ssh_port"] = int(ask("SSH 포트", default=22, validator=port_validator))
        t["auth"] = choose("인증", [("key", "pem 키"), ("password", "비밀번호")])
        if t["auth"] == "key":
            t["key"] = str(Path(ask("pem 키 경로", validator=file_validator)).expanduser().resolve())
        else:
            t["password"] = ask_password()

    if t["type"] == "eic":
        t["instance_id"] = ask("배스천 인스턴스 ID (i-...)")
        t["profile"] = ask("AWS 프로파일")
        t["os_user"] = ask("배스천 OS 유저", default="ec2-user")
        t["region"] = ask("리전 (비우면 프로파일 설정)", default="", required=False)
        t["eice_id"] = ask("EIC Endpoint ID (비우면 자동 탐색)", default="", required=False)
        t["remote_host"] = ask("RDS 엔드포인트")
        t["remote_port"] = int(ask("RDS 포트", default=3306, validator=port_validator))
    elif t["type"] == "ssh":
        ask_ssh_login("배스천")
        t["remote_host"] = ask("RDS 엔드포인트")
        t["remote_port"] = int(ask("RDS 포트", default=3306, validator=port_validator))
    elif t["type"] == "web":
        ask_ssh_login("SSH 서버")
        t["remote_host"] = ask("서비스 호스트 (SSH 서버에서 본 주소)", default=WEB_DEFAULT_HOST)
        t["remote_port"] = int(ask("서비스 포트", default=8080, validator=port_validator))
        t["scheme"] = choose("프로토콜", [("http", "http"), ("https", "https")])
    elif t["type"] == "shell":
        ask_ssh_login("SSH 서버")
    else:
        t["eice_id"] = ask("EIC Endpoint ID (eice-...)")
        t["profile"] = ask("AWS 프로파일")
        t["region"] = ask("리전 (비우면 프로파일 설정)", default="", required=False)
        t["private_ip"] = ask("대상 내부 IP")
        t["remote_port"] = int(ask("대상 포트", default=3306, validator=port_validator))

    if is_tunnel(t):
        client = "브라우저" if t["type"] == "web" else "DataGrip"
        t["local_port"] = int(ask(f"로컬 포트 ({client} 에서 접속할 포트)", validator=local_port_validator))
    t = {k: v for k, v in t.items() if v not in (None, "")}

    tunnels.append(t)
    save_config(cfg)
    if is_tunnel(t):
        print(f"\n등록됨: [{label(cfg, group_name)}] {t['name']}  "
              f"127.0.0.1:{t['local_port']} → {target_of(t)}  via {via_of(t)}")
    else:
        print(f"\n등록됨: [{label(cfg, group_name)}] {t['name']}  {via_of(t)}\n"
              f"접속: tunsw ssh '{label(cfg, group_name)}' {t['name']}")
    if url_of(t):
        print(f"브라우저: {url_of(t)}")


def ask_password():
    while True:
        try:
            value = getpass.getpass("  SSH 비밀번호: ")
        except EOFError:
            die("\n입력이 중단되었습니다.")
        if value:
            return value
        print("    값을 입력하세요.")


REQUIRED = {
    "eic": ("instance_id", "profile", "remote_host", "remote_port"),
    "ssh": ("host", "user", "remote_host", "remote_port"),
    "eic-direct": ("eice_id", "profile", "private_ip", "remote_port"),
    "web": ("host", "user", "remote_port"),
    "shell": ("host", "user"),
}
PORT_FIELDS = ("local_port", "remote_port", "ssh_port")


def validate_tunnel(t, others):
    """문제가 있으면 메시지를, 없으면 None 을 반환한다. others: 같은 그룹의 나머지 터널"""
    if not t.get("name"):
        return "이름을 입력하세요."
    if t.get("type") not in TYPES:
        return "방식을 선택하세요."
    required = REQUIRED[t["type"]] + (("local_port",) if is_tunnel(t) else ())
    missing = [f for f in required if t.get(f) in (None, "")]
    if missing:
        return "필수 항목이 비었습니다: " + ", ".join(missing)
    for f in PORT_FIELDS:
        if f in t and not (isinstance(t[f], int) and 1 <= t[f] <= 65535):
            return f"{f} 는 1~65535 사이 숫자여야 합니다."
    if t["type"] in SSH_TYPES:
        auth = t.get("auth", "key")
        if auth not in AUTHS:
            return "인증 방식은 key 또는 password 여야 합니다."
        if auth == "key":
            if not t.get("key"):
                return "pem 키 경로를 입력하세요."
            if not Path(t["key"]).expanduser().is_file():
                return f"pem 키 파일이 없습니다: {t['key']}"
        elif not t.get("password"):
            return "SSH 비밀번호를 입력하세요."
    if t["type"] == "web" and t.get("scheme", "http") not in SCHEMES:
        return "프로토콜은 http 또는 https 여야 합니다."
    for o in others:
        if o["name"] == t["name"]:
            return f"'{t['name']}' 이름이 이미 있습니다."
        if is_tunnel(t) and o.get("local_port") == t["local_port"]:
            return f"로컬 포트 {t['local_port']} 는 '{o['name']}' 가 쓰고 있습니다."
    return None


def parse_tunnel_json(text):
    try:
        t = json.loads(text)
    except json.JSONDecodeError as e:
        die(f"JSON 오류: {e}")
    t = {k: v for k, v in t.items() if v not in (None, "")}
    if t.get("key"):
        t["key"] = str(Path(t["key"]).expanduser())
    return t


def add_json(args):
    cfg = load_config()
    group = get_group(cfg, args.group)
    t = parse_tunnel_json(args.json)
    replace = args.replace
    if replace and not any(o["name"] == replace for o in group["tunnels"]):
        die(f"'{replace}' 터널이 없습니다.")
    others = [o for o in group["tunnels"] if o["name"] != replace]
    error = validate_tunnel(t, others)
    if error:
        die(error)
    if replace:
        group["tunnels"] = [t if o["name"] == replace else o for o in group["tunnels"]]
    else:
        group["tunnels"].append(t)
    save_config(cfg)


def status_json():
    cfg = load_config()
    running = daemon_group()
    try:
        status = json.loads(STATUS.read_text()) if running else {}
    except (FileNotFoundError, json.JSONDecodeError):
        status = {}
    listeners = listening_pids() if running else {}
    enabled = enabled_names(running) if running else set()
    groups = []
    for key, group in cfg["groups"].items():
        tunnels = []
        for t in group["tunnels"]:
            s = status.get("tunnels", {}).get(t["name"], {})
            on = key == running and t["name"] in enabled and is_tunnel(t)
            state = tunnel_state(t, s, listeners) if on else "off"
            tunnels.append({
                "config": t, "target": target_of(t), "via": via_of(t), "url": url_of(t),
                "enabled": on, "state": state,
                "restarts": s.get("restarts", 0), "last_error": s.get("last_error"),
            })
        groups.append({"key": key, "label": group.get("label") or key, "tunnels": tunnels})
    print(json.dumps({"running": running, "groups": groups, "log": str(LOGFILE)},
                     ensure_ascii=False))


def cmd_list(args):
    cfg = load_config()
    names = [args.group] if args.group else list(cfg["groups"])
    active = daemon_group()
    for name in names:
        group = get_group(cfg, name)
        mark = "  ← 실행 중" if name == active else ""
        print(f"[{group.get('label') or name}] ({name}){mark}")
        if not group["tunnels"]:
            print("  (등록된 터널 없음 — tunsw add)")
        for t in group["tunnels"]:
            if not is_tunnel(t):
                print(f"  {t['name']:<22} {via_of(t)}  (tunsw ssh 로 접속)")
                continue
            print(f"  {t['name']:<22} 127.0.0.1:{t['local_port']:<6} → {target_of(t)}")
            print(f"  {'':<22} via {via_of(t)}")
            if url_of(t):
                print(f"  {'':<22} 브라우저 {url_of(t)}")
        print()


def cmd_remove(args):
    cfg = load_config()
    group = get_group(cfg, args.group)
    before = len(group["tunnels"])
    group["tunnels"] = [t for t in group["tunnels"] if t["name"] != args.name]
    if len(group["tunnels"]) == before:
        die(f"'{args.group}' 그룹에 '{args.name}' 터널이 없습니다.")
    save_config(cfg)
    print(f"삭제됨: {args.group}/{args.name}")


def cmd_group_add(args):
    cfg = load_config()
    name = args.name.strip()
    error = validate_group_name(cfg, name)
    if error:
        die(error)
    cfg["groups"][name] = {"label": name, "tunnels": []}
    save_config(cfg)
    print(f"그룹 추가됨: {name}")


def cmd_group_rename(args):
    """표시 이름만 바꾼다. 키는 그대로라 켜진 터널과 CLI 에서 쓰던 이름이 유지된다."""
    cfg = load_config()
    key = resolve_group(cfg, args.group)
    name = args.new_name.strip()
    error = validate_group_name(cfg, name, exclude=key)
    if error:
        die(error)
    cfg["groups"][key]["label"] = name
    save_config(cfg)
    print(f"그룹 이름 변경: {args.group} → {name}")


def cmd_group_remove(args):
    cfg = load_config()
    key = resolve_group(cfg, args.group)
    count = len(cfg["groups"][key]["tunnels"])
    if count and not args.force:
        die(f"'{label(cfg, key)}' 에 터널 {count}개가 있습니다. 함께 지우려면 --force")
    name = label(cfg, key)
    if daemon_group() == key:
        stop_daemon()
        write_desired(None, [])
    del cfg["groups"][key]
    save_config(cfg)
    print(f"그룹 삭제됨: {name}")


def cmd_edit(_args):
    load_config()
    editor = os.environ.get("EDITOR", "vi")
    subprocess.call([editor, str(CONFIG)])
    try:
        load_config()
    except json.JSONDecodeError as e:
        die(f"config.json 문법 오류: {e}")


# ---------------------------------------------------------------- 명령: 실행 제어

def read_pid():
    try:
        pid = int(PIDFILE.read_text().split()[0])
    except (FileNotFoundError, ValueError, IndexError):
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return None
    except PermissionError:
        pass
    return pid


def daemon_group():
    if read_pid() is None:
        return None
    try:
        return PIDFILE.read_text().split()[1]
    except IndexError:
        return None


def read_desired():
    """켜져 있어야 할 터널 목록. 데몬이 1초마다 읽어 실제 상태를 맞춘다."""
    try:
        d = json.loads(DESIRED.read_text())
        return {"group": d.get("group"), "tunnels": list(d.get("tunnels", []))}
    except (FileNotFoundError, json.JSONDecodeError):
        return {"group": None, "tunnels": []}


def write_desired(group_name, names):
    write_json(DESIRED, {"group": group_name, "tunnels": sorted(names)})


def resolve_names(cfg, group_name, names):
    group = get_group(cfg, group_name)
    all_names = [t["name"] for t in group["tunnels"] if is_tunnel(t)]
    if not all_names:
        die(f"[{label(cfg, group_name)}] 에 등록된 터널이 없습니다. 먼저: tunsw add '{label(cfg, group_name)}'")
    shells = [n for n in names if n not in all_names and any(t["name"] == n for t in group["tunnels"])]
    if shells:
        die(f"SSH 접속은 켜고 끄지 않습니다. 접속: tunsw ssh '{label(cfg, group_name)}' {shells[0]}")
    unknown = [n for n in names if n not in all_names]
    if unknown:
        die(f"[{label(cfg, group_name)}] 에 없는 터널: {', '.join(unknown)}")
    return names or all_names


def turn_on(group_name, names):
    """터널을 켠다(names 가 비면 그룹 전체). 다른 그룹이 켜져 있으면 그 그룹은 꺼진다."""
    cfg = load_config()
    targets = resolve_names(cfg, group_name, names)
    running = daemon_group()
    desired = read_desired()
    on = set(targets)
    if running == group_name and desired["group"] == group_name:
        on |= set(desired["tunnels"])
    write_desired(group_name, on)
    if running != group_name:
        if running:
            stop_daemon()
        start_daemon(group_name)
    print(f"[{label(cfg, group_name)}] 켬: {', '.join(sorted(targets))}")


def turn_off(group_name, names):
    """터널을 끈다(names 가 비면 그룹 전체). 남은 터널이 없으면 데몬을 멈춘다."""
    cfg = load_config()
    targets = resolve_names(cfg, group_name, names)
    if daemon_group() != group_name:
        print(f"[{label(cfg, group_name)}] 은 꺼져 있습니다.")
        return
    remaining = set(read_desired()["tunnels"]) - set(targets)
    write_desired(group_name, remaining)
    if not remaining:
        stop_daemon()
    print(f"[{label(cfg, group_name)}] 끔: {', '.join(sorted(targets))}")


def cmd_on(args):
    turn_on(args.group, args.names)


def cmd_off(args):
    turn_off(args.group, args.names)


def cmd_use(args):
    cfg = load_config()
    turn_on(args.group or choose_group(cfg, "켤 그룹"), [])


def find_tunnel(cfg, group_name, name):
    t = next((t for t in get_group(cfg, group_name)["tunnels"] if t["name"] == name), None)
    if t is None:
        die(f"[{label(cfg, group_name)}] 에 없는 터널: {name}")
    return t


def cmd_open(args):
    """web 터널을 (꺼져 있으면 켜고) 브라우저로 연다."""
    t = find_tunnel(load_config(), args.group, args.name)
    url = url_of(t)
    if not url:
        die(f"'{args.name}' 은 웹 터널이 아닙니다.")
    if args.name not in enabled_names(args.group):
        turn_on(args.group, [args.name])
    for _ in range(100):  # 연결될 때까지 최대 20초 기다린다
        if t["local_port"] in listening_pids():
            break
        time.sleep(0.2)
    else:
        die(f"'{args.name}' 이 20초 안에 연결되지 않았습니다. 로그: tunsw logs")
    subprocess.call(["open", url])


def cmd_ssh(args):
    """SSH 접속(shell) 항목으로 접속한다. --window 면 새 터미널 창에서 연다 (앱의 "접속" 버튼)."""
    t = find_tunnel(load_config(), args.group, args.name)
    if t["type"] != "shell":
        die(f"'{args.name}' 은 SSH 접속 항목이 아닙니다 ({t['type']}).")
    if args.window:
        open_terminal(["ssh", args.group, args.name], args.terminal)
        return
    cmd = build_command(t, None)
    if t.get("auth") == "password":
        ensure_askpass()
    print(f"{t['name']}: {target_of(t)} 접속 중…", file=sys.stderr)
    os.execvpe(cmd[0], cmd, build_env(t) or os.environ)


def cmd_test(args):
    """저장하지 않은 입력값(--json)으로 SSH 로그인만 해 보고 바로 끊는다 (ssh·web·shell).

    터널(포워딩)은 만들지 않는다. 처음 보는 서버면 호스트 키를 known_hosts 에 등록한다.
    """
    # 앱에서 취소하면 SIGTERM 이 온다. 예외로 바꿔야 subprocess.run 이 ssh 도 함께 종료한다.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit("취소했습니다."))
    t = parse_tunnel_json(args.json)
    if t.get("type") not in SSH_TYPES:
        die("연결 테스트는 SSH 로 접속하는 방식에서만 할 수 있습니다.")
    missing = [f for f in ("host", "user") if not t.get(f)]
    if missing:
        die("필수 항목이 비었습니다: " + ", ".join(missing))
    port = t.get("ssh_port", 22)
    if not (isinstance(port, int) and 1 <= port <= 65535):
        die("ssh_port 는 1~65535 사이 숫자여야 합니다.")
    ensure_home()
    password = t.get("auth") == "password"
    if password:
        if not t.get("password"):
            die("SSH 비밀번호를 입력하세요.")
        ensure_askpass()
    else:
        if not t.get("key"):
            die("pem 키 경로를 입력하세요.")
        if not Path(t["key"]).expanduser().is_file():
            die(f"pem 키 파일이 없습니다: {t['key']}")
    cmd = build_command({**t, "type": "shell"}, None)
    # 앞에 둔 -o 가 우선한다. 키 인증은 비밀번호·패스프레이즈를 묻지 않고 실패하게 한다.
    cmd[1:1] = ["-o", f"ConnectTimeout={args.timeout}"] + ([] if password else ["-o", "BatchMode=yes"])
    cmd.append("exit")
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=args.timeout, env=build_env(t))
    except subprocess.TimeoutExpired:
        die(f"연결 시간 초과 ({args.timeout}초)")
    if r.returncode != 0:
        die("연결 실패: " + last_nonempty(r.stderr))
    print(f"연결 성공: {target_of({**t, 'type': 'shell'})}")


# 새 창에서 명령을 실행할 수 있는 터미널 앱. 앞에 있는 것일수록 기본으로 고른다 (macOS 터미널은 마지막).
TERMINALS = [
    ("iterm", "iTerm2", "iTerm.app"),
    ("ghostty", "Ghostty", "Ghostty.app"),
    ("wezterm", "WezTerm", "WezTerm.app"),
    ("kitty", "kitty", "kitty.app"),
    ("alacritty", "Alacritty", "Alacritty.app"),
    ("terminal", "터미널", "Terminal.app"),
]
APP_DIRS = [Path("/Applications"), Path.home() / "Applications",
            Path("/System/Applications/Utilities"), Path("/Applications/Utilities")]

ITERM_SCRIPT = """on run argv
  tell application "iTerm"
    activate
    set w to (create window with default profile)
    tell current session of w to write text (quoted form of item 1 of argv)
  end tell
end run"""


def installed_terminals():
    """[(id, 이름, 앱 경로)] — 설치된 것만, 기본으로 고를 순서대로"""
    found = []
    for tid, name, bundle in TERMINALS:
        app = next((d / bundle for d in APP_DIRS if (d / bundle).is_dir()), None)
        if app:
            found.append((tid, name, app))
    return found


def cmd_terminals(args):
    terms = installed_terminals()
    if args.json:
        print(json.dumps([{"id": tid, "name": name} for tid, name, _ in terms], ensure_ascii=False))
    else:
        for tid, name, app in terms:
            print(f"  {tid:<10} {name}  ({app})")


def open_terminal(engine_args, terminal=None):
    """터미널 앱 새 창에서 tunsw 명령을 실행한다. terminal: TERMINALS 의 id (없으면 설치된 것 중 첫 번째)

    명령은 .command 스크립트로 만들어 넘기고, 스크립트는 실행되자마자 스스로 지운다.
    """
    terms = installed_terminals()
    if not terms:
        die("터미널 앱을 찾지 못했습니다.")
    tid, name, app = next((t for t in terms if t[0] == terminal), terms[0])
    ensure_home()
    fd, script = tempfile.mkstemp(prefix="terminal-", suffix=".command", dir=HOME)
    cmd = [sys.executable, str(Path(__file__).resolve())] + engine_args
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        # 새 창은 이 프로세스의 환경을 물려받지 않으므로 설정 위치를 넘겨 준다
        f.write(f'#!/bin/sh\nrm -f "$0"\nclear\nexport TUNSW_HOME={shlex.quote(str(HOME))}\nexec '
                + " ".join(shlex.quote(a) for a in cmd) + "\n")
    os.chmod(script, 0o700)
    if tid == "iterm":
        # iTerm 은 파일로 열면 매번 실행할지 묻는다. 새 창을 만들어 스크립트 경로를 입력한다.
        launch = ["osascript", "-e", ITERM_SCRIPT, script]
    elif tid == "terminal":
        launch = ["open", "-a", str(app), script]
    elif tid == "wezterm":
        launch = ["open", "-na", str(app), "--args", "start", "--", script]
    elif tid == "kitty":
        launch = ["open", "-na", str(app), "--args", script]
    else:  # ghostty, alacritty
        launch = ["open", "-na", str(app), "--args", "-e", script]
    r = subprocess.run(launch, capture_output=True, text=True)
    if r.returncode != 0:
        Path(script).unlink(missing_ok=True)
        die(f"{name} 을(를) 열지 못했습니다: {last_nonempty(r.stderr)}")


def cmd_restart(_args):
    group_name = daemon_group()
    if not group_name:
        die("켜진 터널이 없습니다.")
    stop_daemon()
    start_daemon(group_name)
    print("재시작했습니다.")


def cmd_stop(_args):
    desired = read_desired()
    if not stop_daemon():
        print("실행 중인 터널이 없습니다.")
        return
    write_desired(desired["group"], [])
    print("터널을 모두 껐습니다.")


def start_daemon(group_name):
    ensure_home()
    if LOGFILE.exists() and LOGFILE.stat().st_size > LOG_MAX_BYTES:
        LOGFILE.replace(LOGFILE.with_suffix(".log.1"))
    with open(os.devnull, "rb") as devnull, LOGFILE.open("ab") as log:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_daemon", group_name],
            stdin=devnull, stdout=log, stderr=log,
            start_new_session=True, close_fds=True,
        )
    for _ in range(30):
        if read_pid():
            return
        time.sleep(0.1)
    die(f"데몬 시작 실패. 로그: {LOGFILE}")


def stop_daemon():
    pid = read_pid()
    if pid is None:
        kill_orphans()
        PIDFILE.unlink(missing_ok=True)
        return False
    os.kill(pid, signal.SIGTERM)
    for _ in range(50):
        if read_pid() is None:
            break
        time.sleep(0.1)
    else:
        os.kill(pid, signal.SIGKILL)
    kill_orphans()
    PIDFILE.unlink(missing_ok=True)
    STATUS.unlink(missing_ok=True)
    return True


def kill_orphans():
    """데몬이 강제 종료돼 남은 터널 프로세스 그룹을 정리한다."""
    try:
        status = json.loads(STATUS.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return
    for s in status.get("tunnels", {}).values():
        if s.get("pgid"):
            try:
                os.killpg(s["pgid"], signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass


STATE_TEXT = {"connected": "● 연결됨", "port_conflict": "⚠ 포트 점유",
              "connecting": "○ 연결 중", "off": "  꺼짐  "}


def enabled_names(group_name):
    """group_name 에서 지금 켜져 있어야 하는 터널 이름 집합 (데몬이 없으면 빈 집합)"""
    desired = read_desired()
    if daemon_group() != group_name or desired["group"] != group_name:
        return set()
    return set(desired["tunnels"])


def listening_pids():
    """{로컬 포트: LISTEN 중인 pid 집합}.

    포트에 직접 접속해 확인하면 그 접속이 터널을 타고 원격까지 전달되므로(EIC 웹소켓 생성,
    RDS 접속 시도) 소켓 목록만 조회한다. 권한상 현재 사용자 프로세스만 보인다.
    """
    try:
        out = subprocess.run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-F", "pn"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    result, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid is not None:
            port = line.rsplit(":", 1)[-1]
            if port.isdigit():
                result.setdefault(int(port), set()).add(pid)
    return result


def tunnel_state(t, s, listeners):
    """connected: 데몬이 띄운 터널 프로세스가 LISTEN 중 / port_conflict: 다른 프로세스가 점유"""
    pids = listeners.get(t["local_port"], set())
    pgid = s.get("pgid")
    if pgid and any(safe_getpgid(p) == pgid for p in pids):
        return "connected"
    if pids:
        return "port_conflict"
    return "connecting"


def safe_getpgid(pid):
    try:
        return os.getpgid(pid)
    except (ProcessLookupError, PermissionError):
        return None


def cmd_status(args):
    if args.json:
        status_json()
        return
    cfg = load_config()
    group_name = daemon_group()
    if group_name is None:
        print("꺼져 있음. 켜기: tunsw use")
        return
    try:
        status = json.loads(STATUS.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        status = {"tunnels": {}}
    print(f"[{label(cfg, group_name)}] 실행 중 (pid {read_pid()})\n")
    listeners = listening_pids()
    enabled = enabled_names(group_name)
    for t in filter(is_tunnel, get_group(cfg, group_name)["tunnels"]):
        s = status["tunnels"].get(t["name"], {})
        state = STATE_TEXT[tunnel_state(t, s, listeners) if t["name"] in enabled else "off"]
        print(f"  {state}  {t['name']:<22} 127.0.0.1:{t['local_port']:<6} → {target_of(t)}"
              f"  (재연결 {s.get('restarts', 0)}회)")
        if s.get("last_error") and state not in (STATE_TEXT["connected"], STATE_TEXT["off"]):
            print(f"           최근 오류: {s['last_error']}")
    print(f"\n로그: tunsw logs -f")


def cmd_logs(args):
    if not LOGFILE.exists():
        print("로그가 없습니다.")
        return
    cmd = ["tail", "-n", str(args.lines)] + (["-f"] if args.follow else []) + [str(LOGFILE)]
    try:
        subprocess.call(cmd)
    except KeyboardInterrupt:
        pass


# ---------------------------------------------------------------- 업데이트
#
# 앱은 git clone 한 레포에서 install.sh 로 설치한다. install.sh 가 레포 경로와 설치한 커밋을
# 앱 번들 Resources/repo, Resources/commit 에 적어 두고, 원격 브랜치와 비교해 새 버전을 찾는다.

class UpdateError(Exception):
    pass


def bundle_files(name):
    """번들 안에서 실행 중이면 그 번들의, 아니면(레포의 CLI) 설치된 앱의 Resources/<name>"""
    return [Path(__file__).resolve().parent / name, APP_BUNDLE / "Contents" / "Resources" / name]


def read_bundle_file(name):
    for f in bundle_files(name):
        if f.is_file():
            return f.read_text().strip()
    return None


def repo_dir():
    repo = read_bundle_file("repo")
    if repo and (Path(repo) / ".git").exists():
        return Path(repo)
    here = Path(__file__).resolve().parent.parent
    if (here / ".git").exists():
        return here
    raise UpdateError("앱을 설치한 레포를 찾지 못했습니다. 레포에서 scripts/install.sh 를 다시 실행하세요.")


def git(repo, *args, timeout=60):
    # 인증을 물어보며 멈추지 않게 한다
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_SSH_COMMAND="ssh -o BatchMode=yes")
    try:
        r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True,
                           timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        raise UpdateError(f"git {args[0]} 시간 초과")
    if r.returncode != 0:
        raise UpdateError(f"git {args[0]} 실패: " + last_nonempty(r.stderr))
    return r.stdout.strip()


def read_update_status():
    try:
        return json.loads(UPDATE_STATUS.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def update_info(fetch=True):
    """설치된 커밋과 원격 브랜치를 비교한다. commits: 설치 후 새로 올라온 커밋 제목 (최신 순)"""
    repo = repo_dir()
    if fetch:
        git(repo, "fetch", "--quiet")
    latest = git(repo, "rev-parse", "@{u}")
    current = read_bundle_file("commit") or git(repo, "rev-parse", "HEAD")
    try:
        commits = git(repo, "log", "--format=%s", f"{current}..{latest}").splitlines()
    except UpdateError:  # 설치한 커밋이 레포에 없으면 (rebase 등) 레포 HEAD 기준
        commits = git(repo, "log", "--format=%s", f"HEAD..{latest}").splitlines()
    return {"repo": str(repo), "current": current[:7], "latest": latest[:7], "commits": commits,
            **{k: v for k, v in read_update_status().items() if k in ("state", "message")}}


def run_update():
    """git pull 후 install.sh 로 빌드·설치한다. install.sh 가 앱을 종료하고 다시 띄운다."""
    repo = repo_dir()
    if git(repo, "status", "--porcelain", "--untracked-files=no"):
        raise UpdateError(f"레포({repo})에 커밋하지 않은 변경이 있어 업데이트하지 않았습니다.")
    if not os.access("/Applications", os.W_OK) and not sys.stdin.isatty():
        raise UpdateError("/Applications 에 설치하려면 관리자 권한이 필요합니다. 터미널에서 tunsw update 를 실행하세요.")
    print(f"업데이트: {repo}", flush=True)
    git(repo, "pull", "--ff-only", timeout=180)
    proc = subprocess.Popen([str(repo / "scripts" / "install.sh")], cwd=repo,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    last = None
    for line in proc.stdout:
        print(line, end="", flush=True)
        if line.strip():
            last = line.strip()
    if proc.wait() != 0:
        raise UpdateError(f"설치 실패: {last or '종료 코드 ' + str(proc.returncode)} (로그: {UPDATE_LOG})")


def cmd_update(args):
    if args.status:
        print(json.dumps(read_update_status(), ensure_ascii=False))
        return
    if args.check:
        try:
            info = update_info()
        except UpdateError as e:
            die(str(e))
        if args.json:
            print(json.dumps(info, ensure_ascii=False))
        elif info["commits"]:
            print(f"새 버전이 있습니다: {info['current']} → {info['latest']} (커밋 {len(info['commits'])}개)")
            for c in info["commits"]:
                print(f"  - {c}")
            print("업데이트: tunsw update")
        else:
            print(f"최신 버전입니다 ({info['current']}).")
        return
    if args.background:
        # 앱이 업데이트 중에 종료되므로 앱과 떨어진 프로세스로 돌린다
        write_json(UPDATE_STATUS, {"state": "running"})
        with open(os.devnull, "rb") as devnull, UPDATE_LOG.open("wb") as log:
            subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "update"],
                             stdin=devnull, stdout=log, stderr=log, start_new_session=True, close_fds=True)
        return
    write_json(UPDATE_STATUS, {"state": "running"})
    try:
        run_update()
    except UpdateError as e:
        write_json(UPDATE_STATUS, {"state": "failed", "message": str(e)})
        die(str(e))
    write_json(UPDATE_STATUS, {"state": "done"})
    print("업데이트했습니다.")


