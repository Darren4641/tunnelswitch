class Supervisor:
    """desired.json 을 1초마다 읽어 터널별 Worker 를 시작·중지한다.

    켜진 터널의 설정이 바뀌면 그 터널만 다시 연결한다.
    """

    def __init__(self, group_name):
        self.group_name = group_name
        self.aws = shutil.which("aws") or "aws"
        self.stopping = threading.Event()
        self.status_lock = threading.Lock()
        self.status = {"group": group_name, "tunnels": {}}
        self.workers = {}
        self.config_error = None

    def run(self):
        PIDFILE.write_text(f"{os.getpid()} {self.group_name}\n")
        signal.signal(signal.SIGTERM, self.handle_stop)
        signal.signal(signal.SIGINT, self.handle_stop)
        logging.info("=== 시작: %s", self.group_name)
        while not self.stopping.is_set():
            self.reconcile()
            self.stopping.wait(1)
        for w in self.workers.values():
            w.stop()
        for w in self.workers.values():
            w.thread.join(timeout=5)
        STATUS.unlink(missing_ok=True)
        PIDFILE.unlink(missing_ok=True)
        logging.info("=== 종료: %s", self.group_name)

    def handle_stop(self, _signum, _frame):
        self.stopping.set()

    def reconcile(self):
        try:
            cfg = load_config()
        except (OSError, json.JSONDecodeError) as e:
            if str(e) != self.config_error:
                logging.error("config.json 을 읽지 못해 현재 상태를 유지합니다: %s", e)
                self.config_error = str(e)
            return
        self.config_error = None
        group = cfg["groups"].get(self.group_name, {"tunnels": []})
        defs = {t["name"]: t for t in group["tunnels"] if is_tunnel(t)}
        desired = read_desired()
        want = set(desired["tunnels"]) if desired["group"] == self.group_name else set()
        want &= set(defs)

        for name in list(self.workers):
            w = self.workers[name]
            if name in want and w.t == defs[name]:
                continue
            logging.info("[%s] %s", name, "설정 변경 — 다시 연결" if name in want else "끔")
            w.stop()
            w.thread.join(timeout=5)
            del self.workers[name]
            self.remove_status(name)

        for name in sorted(want - set(self.workers)):
            t = defs[name]
            if t["type"] == "eic":
                ensure_eic_key()
            if t.get("auth") == "password":
                ensure_askpass()
            w = Worker(self, t)
            self.workers[name] = w
            w.thread.start()

    def update_status(self, name, **fields):
        with self.status_lock:
            self.status["tunnels"].setdefault(name, {"restarts": 0}).update(fields)
            write_json(STATUS, self.status)

    def remove_status(self, name):
        with self.status_lock:
            self.status["tunnels"].pop(name, None)
            write_json(STATUS, self.status)


def aws_common(t):
    args = ["--profile", t["profile"]]
    if t.get("region"):
        args += ["--region", t["region"]]
    return args


def push_eic_key(t, aws):
    cmd = [aws, "ec2-instance-connect", "send-ssh-public-key",
           "--instance-id", t["instance_id"],
           "--instance-os-user", t.get("os_user", "ec2-user"),
           "--ssh-public-key", f"file://{EIC_KEY}.pub"] + aws_common(t)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        raise TunnelError("send-ssh-public-key 시간 초과")
    if r.returncode != 0:
        raise TunnelError("send-ssh-public-key 실패: " + last_nonempty(r.stderr))


def build_command(t, aws):
    """터널 명령. shell(SSH 접속)이면 포워딩 없이 셸로 접속하는 ssh 명령"""
    login = t["type"] == "shell"
    password = t.get("auth") == "password"
    ssh_opts = [] if login else ["-N", "-o", "ExitOnForwardFailure=yes"]
    ssh_opts += [
        "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=3",
        "-o", "IdentitiesOnly=yes",
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", f"UserKnownHostsFile={KNOWN_HOSTS}",
    ]
    if password:
        # 비밀번호는 SSH_ASKPASS 로 넘긴다 (build_env). 틀리면 한 번만 시도하고 끊는다.
        ssh_opts += ["-o", "BatchMode=no", "-o", "PubkeyAuthentication=no",
                     "-o", "PreferredAuthentications=password,keyboard-interactive",
                     "-o", "NumberOfPasswordPrompts=1"]
    elif not login:
        ssh_opts += ["-o", "BatchMode=yes"]
    forward = [] if login else ["-L", f"127.0.0.1:{t['local_port']}:{remote_host_of(t)}:{t['remote_port']}"]
    if t["type"] == "eic":
        proxy = [aws, "ec2-instance-connect", "open-tunnel",
                 "--instance-id", t["instance_id"]] + aws_common(t)
        if t.get("eice_id"):
            proxy += ["--instance-connect-endpoint-id", t["eice_id"]]
        return ["ssh"] + ssh_opts + [
            "-i", str(EIC_KEY),
            "-o", "ProxyCommand=" + " ".join(sh_quote(a) for a in proxy),
        ] + forward + [f"{t.get('os_user', 'ec2-user')}@{t['instance_id']}"]
    if t["type"] in SSH_TYPES:
        identity = [] if password else ["-i", t["key"]]
        return ["ssh"] + ssh_opts + identity + [
            "-p", str(t.get("ssh_port", 22)),
        ] + forward + [f"{t['user']}@{t['host']}"]
    if t["type"] == "eic-direct":
        return [aws, "ec2-instance-connect", "open-tunnel",
                "--instance-connect-endpoint-id", t["eice_id"],
                "--private-ip-address", t["private_ip"],
                "--remote-port", str(t["remote_port"]),
                "--local-port", str(t["local_port"])] + aws_common(t)
    raise TunnelError(f"알 수 없는 방식: {t['type']}")


def build_env(t):
    """비밀번호 인증이면 ssh 가 tty 없이 askpass 스크립트로 비밀번호를 읽게 한다."""
    if t.get("auth") != "password":
        return None
    env = dict(os.environ)
    env.update(SSH_ASKPASS=str(ASKPASS), SSH_ASKPASS_REQUIRE="force",
               TUNSW_SSH_PASSWORD=t["password"])
    return env


class Worker:
    """터널 하나. 끊기면 백오프하며 다시 연결하고, stop() 하면 프로세스 그룹째 종료한다."""

    def __init__(self, sup, t):
        self.sup = sup
        self.t = t
        self.name = t["name"]
        self.stop_event = threading.Event()
        self.proc = None
        self.proc_lock = threading.Lock()
        self.thread = threading.Thread(target=self.loop, daemon=True)

    def stop(self):
        self.stop_event.set()
        with self.proc_lock:
            proc = self.proc
        if proc:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass

    def loop(self):
        failures = 0
        attempts = 0
        self.sup.update_status(self.name, restarts=0, pgid=None, last_error=None)
        while not self.stop_event.is_set():
            if attempts:
                self.sup.update_status(self.name, restarts=attempts)
            attempts += 1
            started = time.monotonic()
            error = self.run_once()
            if self.stop_event.is_set():
                break
            if time.monotonic() - started >= STABLE_SECONDS:
                failures = 0
            failures += 1
            delay = min(MAX_BACKOFF, 2 ** failures)
            self.sup.update_status(self.name, pgid=None, last_error=error)
            logging.warning("[%s] 끊김 (%s) — %d초 후 재연결", self.name, error, delay)
            self.stop_event.wait(delay)

    def run_once(self):
        """터널을 띄우고 종료될 때까지 기다린다. 종료 사유를 반환한다."""
        t = self.t
        if not port_free(t["local_port"]):
            return f"로컬 포트 {t['local_port']} 가 이미 사용 중"
        try:
            if t["type"] == "eic":
                push_eic_key(t, self.sup.aws)
            cmd = build_command(t, self.sup.aws)
            env = build_env(t)
        except TunnelError as e:
            return str(e)

        logging.info("[%s] 연결 시도 127.0.0.1:%d → %s", self.name, t["local_port"], target_of(t))
        with self.proc_lock:
            if self.stop_event.is_set():
                return "중지됨"
            proc = self.proc = subprocess.Popen(
                cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, env=env,
                stderr=subprocess.STDOUT, start_new_session=True, text=True, errors="replace")
        self.sup.update_status(self.name, pgid=proc.pid, last_error=None)
        last_line = None
        for line in proc.stdout:
            line = line.rstrip()
            if line:
                last_line = line
                logging.info("[%s] %s", self.name, line)
        code = proc.wait()
        with self.proc_lock:
            self.proc = None
        return last_line or f"종료 코드 {code}"


class TunnelError(Exception):
    pass


def ensure_eic_key():
    if EIC_KEY.exists():
        return
    subprocess.run(["ssh-keygen", "-t", "ed25519", "-N", "", "-q",
                    "-C", "tunsw-eic", "-f", str(EIC_KEY)], check=True)
    logging.info("EIC 용 임시 SSH 키 생성: %s", EIC_KEY)


def ensure_askpass():
    """비밀번호를 환경변수에서 읽어 출력하는 SSH_ASKPASS 스크립트. 비밀번호 자체는 담지 않는다."""
    script = '#!/bin/sh\nprintf \'%s\\n\' "$TUNSW_SSH_PASSWORD"\n'
    if ASKPASS.exists() and ASKPASS.read_text() == script:
        return
    ASKPASS.write_text(script)
    os.chmod(ASKPASS, 0o700)


def port_free(port):
    """다른 프로세스가 LISTEN 중이 아니면 True.

    ssh·aws open-tunnel 처럼 SO_REUSEADDR 로 검사해야 끊긴 연결의 잔재(클라이언트가
    CLOSE_WAIT 로 쥐고 있는 소켓 등)를 사용 중으로 오판하지 않는다.
    """
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def last_nonempty(text):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return lines[-1] if lines else "(메시지 없음)"


def sh_quote(s):
    return s if s and all(c.isalnum() or c in "-_./:=@" for c in s) else "'" + s.replace("'", "'\\''") + "'"


def migrate_legacy_home():
    """예전 설정 폴더(~/.config/dbtunnel)를 새 위치로 옮긴다. 켜져 있던 터널은 새 데몬으로 다시 켠다.

    예전 데몬은 예전 폴더에 pid·상태 파일을 쓰므로 먼저 멈춘 뒤 옮긴다.
    """
    if "TUNSW_HOME" in os.environ or HOME.exists() or not LEGACY_HOME.is_dir():
        return
    try:
        pid = int((LEGACY_HOME / "daemon.pid").read_text().split()[0])
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            os.kill(pid, 0)
            time.sleep(0.1)
        os.kill(pid, signal.SIGKILL)
    except (FileNotFoundError, ValueError, IndexError, ProcessLookupError, PermissionError):
        pass
    try:
        LEGACY_HOME.rename(HOME)
    except OSError as e:
        print(f"예전 설정({LEGACY_HOME})을 옮기지 못했습니다: {e}", file=sys.stderr)
        return
    kill_orphans()
    PIDFILE.unlink(missing_ok=True)
    STATUS.unlink(missing_ok=True)
    print(f"설정을 옮겼습니다: {LEGACY_HOME} → {HOME}", file=sys.stderr)
    desired = read_desired()
    if desired["group"] in load_config()["groups"] and desired["tunnels"]:
        start_daemon(desired["group"])


def cmd_daemon(args):
    logging.basicConfig(format="%(asctime)s %(levelname)s %(message)s",
                        datefmt="%m-%d %H:%M:%S", level=logging.INFO, stream=sys.stderr)
    if read_pid() not in (None, os.getpid()):
        logging.error("이미 데몬이 실행 중입니다.")
        sys.exit(1)
    Supervisor(args.group).run()


